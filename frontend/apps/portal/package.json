{
  "name": "@adha/portal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18.14.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:unit": "vitest run --passWithNoTests",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed --project=chromium --workers=1",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "PWDEBUG=1 playwright test --project=chromium --workers=1",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:e2e:report": "playwright show-report",
    "test:e2e:mock": "E2E_USE_MOCK=true playwright test",
    "test:e2e:real": "E2E_USE_MOCK=false E2E_CLEANUP_RECORDS=true playwright test --project=chromium --workers=1",
    "test:e2e:real:headed": "E2E_USE_MOCK=false E2E_CLEANUP_RECORDS=true playwright test --headed --project=chromium --workers=1",
    "test:e2e:real:keep-records": "E2E_USE_MOCK=false E2E_CLEANUP_RECORDS=false playwright test --project=chromium --workers=1"
  },
  "dependencies": {
    "@adha/services": "workspace:*",
    "@adha/ui-assets": "workspace:*",
    "@adha/ui-library": "workspace:*",
    "@adha/ui-tokens": "workspace:*",
    "@adha/utils": "workspace:*",
    "@health.gov.au/health-design-system": "^3.2.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.2"
  }
}
